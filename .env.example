# Copy to .env.local for local runs, and set the same names in the Vercel
# project settings. Never commit real values.

# OpenRouter API key used for all image requests (encrypted).
OPENROUTER_API_KEY=
# Shared secret that claude.ai sends in the Authorization header; at least 32 random characters (encrypted).
CONNECTOR_SECRET=
# Secret Vercel Cron sends to /cron/cleanup; at least 32 random characters (encrypted).
CRON_SECRET=
# Blob credentials: set one of BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID. If the token is set it is
# used; otherwise the function authenticates to Blob with the OIDC token Vercel provides.
# Read-write token for the Vercel Blob store. Creating the store from the CLI sets it as a plain
# variable; connecting the store from the dashboard with the token box unchecked sets none.
BLOB_READ_WRITE_TOKEN=
# Id of the Blob store, with or without a "store_" prefix. Required without a token. With a token
# it is optional and overrides the id inside the token for the public base URL.
BLOB_STORE_ID=
# Model used when a tool call does not name one; empty uses the built-in default.
DEFAULT_MODEL=
# Days an image is kept before the daily cleanup deletes it; empty means 30.
RETENTION_DAYS=
# Optional HTTP-Referer sent to OpenRouter; empty means no header is sent.
OPENROUTER_REFERER=
