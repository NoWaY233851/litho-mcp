# Allowlist: upload only what the build needs. Anything else in a working copy
# stays local. A new top-level build input must be added here, or the deploy
# will not see it.
/*
!api
!src
!ui
!scripts
!public
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!vercel.json
# Environment files are never uploaded, including a stray one under public/, which is served as-is.
.env*
